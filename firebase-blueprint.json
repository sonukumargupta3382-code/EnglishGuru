{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and progress",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "progress": {
          "type": "object",
          "properties": {
            "completedLessons": { "type": "array", "items": { "type": "string" } },
            "xp": { "type": "number" }
          }
        }
      },
      "required": ["id", "name", "email", "progress"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A chat message in the practice section",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "text", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/users/{userId}/chat/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "User chat history"
    }
  }
}
