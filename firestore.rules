rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - id: string (required) - User ID
    //   - name: string (required) - User name
    //   - email: string (required) - User email
    //   - progress: map (required) - User progress
    //     - completedLessons: list of strings
    //     - xp: number
    //
    // Collection: users/{userId}/chat
    // Document ID: {messageId}
    // Fields:
    //   - role: string (required, 'user' or 'model')
    //   - text: string (required)
    //   - timestamp: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidUser() {
      let data = request.resource.data;
      return hasRequiredFields(['id', 'name', 'email', 'progress']) &&
             data.id is string && data.id == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() >= 0 && data.email.size() < 150 &&
             data.progress is map &&
             data.progress.keys().hasAll(['completedLessons', 'xp']) &&
             data.progress.completedLessons is list &&
             data.progress.xp is number && data.progress.xp >= 0;
    }

    function isValidChatMessage() {
      let data = request.resource.data;
      return hasRequiredFields(['role', 'text', 'timestamp']) &&
             data.role in ['user', 'model'] &&
             data.text is string && data.text.size() > 0 && data.text.size() < 5000 &&
             data.timestamp is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser();
      allow update: if isOwner(userId) && isValidUser() && request.resource.data.id == resource.data.id;
      
      match /chat/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChatMessage();
        // Chat messages should not be updated or deleted
        allow update, delete: if false;
      }
    }
  }
}
